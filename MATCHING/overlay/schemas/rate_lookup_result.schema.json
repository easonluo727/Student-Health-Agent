{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rate_lookup_result.v1",
  "title": "Result of one deterministic rate lookup. Unavailable results carry allowed_amount = null and a reason_code.",
  "type": "object",
  "required": ["allowed_amount", "status", "reason_code", "allowed_amount_basis", "match_path", "match_keys",
               "selected_provider_npi", "exact_provider_rate_found", "fallback_provider_count", "p10", "p90",
               "mrf_file_dates", "source_ids", "estimate_scope", "service_date", "service_date_validated",
               "warnings", "message", "request_id", "run_id", "adapter_version", "lookup_version", "log_status"],
  "properties": {
    "allowed_amount": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "status": {"enum": ["provider_rate", "nearby_provider_estimate", "network_estimate", "rate_unavailable"]},
    "reason_code": {"type": ["string", "null"]},
    "exact_reason_code": {"type": ["string", "null"], "description": "Why the selected provider had no exact rate"},
    "allowed_amount_basis": {"type": ["string", "null"]},
    "source_status": {"type": ["string", "null"], "description": "Pipeline label from the aggregate row (verified_rate/estimated_rate)"},
    "match_path": {"type": ["string", "null"]},
    "match_keys": {"type": "object"},
    "estimate_scope": {"enum": ["provider_specific", "nearby_provider_cohort", "network_aggregate",
                                "mixed_provider_and_nearby", null]},
    "selected_provider_npi": {"type": ["string", "null"]},
    "exact_provider_rate_found": {"type": "boolean"},
    "fallback_provider_count": {"type": "integer", "minimum": 0},
    "n_providers": {"type": ["integer", "null"]},
    "p10": {"type": ["number", "null"]},
    "p90": {"type": ["number", "null"]},
    "mrf_file_dates": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array"},
    "source_urls": {"type": "array"},
    "components": {"type": "array"},
    "fallback": {"type": ["object", "null"]},
    "code_choice": {"type": ["object", "null"]},
    "service_date": {"type": ["string", "null"]},
    "service_date_validated": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "message": {"type": "string"},
    "request_id": {"type": "string"},
    "run_id": {"type": "string"},
    "adapter_version": {"type": "string"},
    "lookup_version": {"type": "string"},
    "log_status": {"type": "string"}
  },
  "if": {"properties": {"status": {"const": "rate_unavailable"}}},
  "then": {"properties": {"allowed_amount": {"type": "null"}, "reason_code": {"type": "string"}}},
  "else": {"properties": {"allowed_amount": {"type": "number"}}}
}
