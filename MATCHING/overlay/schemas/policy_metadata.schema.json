{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy_metadata.v1",
  "title": "Policy/plan metadata extracted from a policy PDF (separate from the Schedule of Benefits)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_plan_id", "issuer", "plan", "region", "coverage", "networks",
               "sources", "extraction_status", "review_status"],
  "properties": {
    "schema_version": {"const": "policy_metadata.v1"},
    "policy_plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$",
                       "description": "Stable local ID chosen by the importer operator, never by the model."},
    "issuer": {"$ref": "#/$defs/sourced_text"},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "product_ids"],
      "properties": {
        "name": {"$ref": "#/$defs/sourced_text"},
        "product_ids": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id_type", "value", "source_page"],
          "properties": {"id_type": {"enum": ["hios", "ein", "group_number", "policy_number", "other"]},
                         "value": {"type": "string"}, "source_page": {"type": "integer", "minimum": 1}}}}
      }
    },
    "region": {"$ref": "#/$defs/sourced_text_or_null"},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_year", "effective_start", "effective_end"],
      "properties": {
        "coverage_year": {"$ref": "#/$defs/sourced_text_or_null"},
        "effective_start": {"$ref": "#/$defs/sourced_date_or_null"},
        "effective_end": {"$ref": "#/$defs/sourced_date_or_null"}
      }
    },
    "networks": {
      "type": "array",
      "description": "Network names exactly as printed in the PDF. These are NOT MRF network names; the mapping lives in policy_mrf_map.",
      "items": {"type": "object", "additionalProperties": false,
                "required": ["name_in_pdf", "policy_network_category", "source_page"],
                "properties": {"name_in_pdf": {"type": "string", "minLength": 1},
                               "policy_network_category": {"enum": ["in-network", "out-of-network", "unspecified"]},
                               "source_page": {"type": "integer", "minimum": 1}}}
    },
    "sources": {
      "type": "object", "additionalProperties": false, "required": ["file", "sha256", "pages"],
      "properties": {"file": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                     "pages": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1}}
    },
    "extraction": {"type": "object"},
    "extraction_status": {"enum": ["extracted", "partial", "failed"]},
    "review_status": {"enum": ["pending_review", "verified", "rejected"]},
    "reviewed_by": {"type": ["string", "null"]}
  },
  "$defs": {
    "sourced_text": {"type": "object", "additionalProperties": false, "required": ["value", "source_page"],
                     "properties": {"value": {"type": "string", "minLength": 1},
                                    "source_page": {"type": "integer", "minimum": 1}}},
    "sourced_text_or_null": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sourced_text"}]},
    "sourced_date_or_null": {"anyOf": [{"type": "null"},
      {"type": "object", "additionalProperties": false, "required": ["value", "source_page"],
       "properties": {"value": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                      "source_page": {"type": "integer", "minimum": 1}}}]}
  }
}
