{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rate_request.v1",
  "title": "Normalized Branch A context handed to the deterministic rate lookup. Exactly one of encounter_key or billing_code.",
  "type": "object",
  "required": ["insurer", "plan_key", "network", "service_date", "selected_provider_npi"],
  "additionalProperties": false,
  "properties": {
    "insurer": {"type": ["string", "null"], "description": "Display/consistency check only; never used as a join key"},
    "plan_key": {"type": "string", "minLength": 1, "description": "Internal stable plan id from plan_profiles"},
    "network": {"type": ["string", "null"], "description": "Exact MRF network name; null only for plans imported without a network filter"},
    "service_description": {"type": ["string", "null"], "description": "Display only; never logged, never a join key"},
    "encounter_key": {"type": ["string", "null"]},
    "billing_code": {"type": ["string", "null"], "pattern": "^[A-Z0-9]{4,7}$"},
    "billing_code_type": {"enum": ["CPT", "HCPCS", null]},
    "billing_class": {"type": ["string", "null"]},
    "place_of_service": {"type": ["string", "null"], "description": "POS code or ordered preference list '20|11'; empty = none listed"},
    "modifier_rule": {"enum": ["global", "mod_26", "global_or_tc_plus_26", null]},
    "service_date": {"type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "selected_provider_npi": {"type": ["string", "null"], "pattern": "^\\d{10}$"}
  },
  "oneOf": [
    {"properties": {"encounter_key": {"type": "string", "minLength": 1}, "billing_code": {"type": "null"}},
     "required": ["encounter_key"]},
    {"properties": {"billing_code": {"type": "string"}, "encounter_key": {"type": "null"}},
     "required": ["billing_code", "billing_class"]}
  ]
}
