{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service_rate_map.v1",
  "title": "Versioned mapping: policy plan + benefit service + setting + policy network category -> rate options",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "service_rate_map.v1"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "policy_plan_id", "service", "setting", "policy_network_category", "options",
                   "review_status", "source"],
      "properties": {
        "entry_id": {"type": "string"},
        "policy_plan_id": {"type": "string"},
        "service": {"type": "string", "description": "Benefit service name exactly as stored in the benefit rule (normalized: lowercase, single spaces)"},
        "setting": {"enum": ["inpatient", "outpatient", "other", null]},
        "policy_network_category": {"enum": ["in-network", "out-of-network"]},
        "clarification_question": {"type": ["string", "null"],
                                   "description": "Required when options has more than one item"},
        "options": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/option"}},
        "review_status": {"enum": ["pending_review", "verified", "rejected"]},
        "reviewed_by": {"type": ["string", "null"]},
        "source": {"type": "string"}
      }
    },
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["option_id", "label", "kind"],
      "properties": {
        "option_id": {"type": "string"},
        "label": {"type": "string"},
        "kind": {"enum": ["A_encounter", "B_components"]},
        "encounter_key": {"type": "string", "description": "A_encounter: key from data/mrf/encounters.csv"},
        "component_benefit_services": {"type": "object", "additionalProperties": {"type": "string"},
          "description": "A_encounter: every encounter component -> benefit service that pays it. All must equal the entry's service, otherwise the A total cannot be used."},
        "components": {"type": "array", "items": {"$ref": "#/$defs/component"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "A_encounter"}}},
         "then": {"required": ["encounter_key", "component_benefit_services"]}},
        {"if": {"properties": {"kind": {"const": "B_components"}}},
         "then": {"required": ["components"]}}
      ]
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "billing_code", "billing_class", "place_of_service", "modifier_rule",
                   "benefit_service", "required"],
      "properties": {
        "component": {"type": "string"},
        "billing_code": {"type": "string"},
        "billing_class": {"enum": ["professional", "institutional"]},
        "place_of_service": {"type": "string", "description": "Exact B_component POS value, e.g. '11', '20|11', or '' for any"},
        "modifier_rule": {"enum": ["global", "global_or_tc_plus_26", "mod_26"]},
        "benefit_service": {"type": "string", "description": "Benefit rule service that pays this component"},
        "benefit_setting": {"enum": ["inpatient", "outpatient", "other", null]},
        "required": {"type": "boolean"}
      }
    }
  }
}
