{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rate_quote.v1",
  "title": "Rate quote returned by the Python resolver. Only quotes with a usable status carry an amount.",
  "type": "object",
  "required": ["quote_id", "status", "usable", "allowed_amount", "rate_table", "policy_plan_id", "mrf_plan_key",
               "insurer", "mrf_network", "encounter_key", "components", "provider_npi", "provider_specific",
               "allowed_amount_basis", "mrf_snapshot_date", "service_date", "source", "mapping",
               "aggregate", "message"],
  "properties": {
    "quote_id": {"type": "string"},
    "status": {"enum": ["success", "estimated", "rate_unavailable", "mapping_pending_review", "mapping_missing",
                        "mapping_invalid", "needs_clarification", "ambiguous_match", "no_match", "no_data_source",
                        "provider_rate_unavailable", "stale_snapshot", "invalid_rate"]},
    "usable": {"type": "boolean", "description": "True only for success/estimated with a finite positive amount"},
    "allowed_amount": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "rate_table": {"enum": ["A_encounter", "B_component", null]},
    "policy_plan_id": {"type": ["string", "null"]},
    "mrf_plan_key": {"type": ["string", "null"]},
    "insurer": {"type": ["string", "null"]},
    "mrf_network": {"type": ["string", "null"]},
    "network_scope": {"type": ["string", "null"]},
    "encounter_key": {"type": ["string", "null"]},
    "components": {"type": "array"},
    "provider_npi": {"type": ["string", "null"]},
    "provider_specific": {"type": "boolean"},
    "aggregate": {"type": "boolean"},
    "allowed_amount_basis": {"type": ["string", "null"]},
    "mrf_snapshot_date": {"type": ["string", "null"]},
    "service_date": {"type": ["string", "null"], "description": "User-supplied date of service; unrelated to the MRF snapshot date"},
    "source": {"type": "object"},
    "mapping": {"type": "object"},
    "clarification": {"type": ["object", "null"]},
    "lookup_status": {"enum": ["provider_rate", "nearby_provider_estimate", "network_estimate", "rate_unavailable"],
                      "description": "rate_lookup_result.v1 status of the underlying lookup"},
    "reason_code": {"type": ["string", "null"], "description": "Machine-readable reason when no rate was found"},
    "estimate_scope": {"enum": ["provider_specific", "nearby_provider_cohort", "network_aggregate",
                                "mixed_provider_and_nearby", null]},
    "lookup": {"type": ["object", "null"], "description": "The lookup result summary (keys, spread, fallback trail)"},
    "message": {"type": "string"}
  }
}
