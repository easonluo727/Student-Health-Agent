{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benefit_rule.v2",
  "title": "One Schedule of Benefits rule (service x setting x policy network category). Never carries a rate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_key", "policy_plan_id", "plan", "service", "setting", "network",
               "copay_usd", "plan_pays_percentage", "patient_pays_percentage", "deductible_applies",
               "prior_authorization", "coverage_status", "source_text", "source_file", "source_page",
               "needs_review", "review_status"],
  "properties": {
    "schema_version": {"const": "benefit_rule.v2"},
    "rule_key": {"type": "string", "description": "Deterministic: policy_plan_id:page:row:network"},
    "policy_plan_id": {"type": "string"},
    "plan": {"type": "string", "description": "Same as policy_plan_id; kept so the original PolicyTools loader works."},
    "service": {"type": "string", "minLength": 1},
    "setting": {"enum": ["inpatient", "outpatient", "other", null]},
    "network": {"enum": ["in-network", "out-of-network", null],
                "description": "Policy benefit category. Not an MRF network name."},
    "copay_usd": {"type": ["number", "null"], "minimum": 0},
    "plan_pays_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "patient_pays_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "deductible_applies": {"type": ["boolean", "null"]},
    "prior_authorization": {"enum": ["required", "not_required", "may_be_required", "not_stated", null]},
    "coverage_status": {"enum": ["covered", "not_covered", "unknown", null]},
    "source_text": {"type": "string"},
    "source_file": {"type": "string"},
    "source_page": {"type": "integer", "minimum": 1},
    "needs_review": {"type": ["boolean", "null"]},
    "review_status": {"enum": ["pending_review", "verified", "rejected"]}
  },
  "not": {"anyOf": [{"required": ["allowed_amount"]}, {"required": ["negotiated_rate"]}]}
}
