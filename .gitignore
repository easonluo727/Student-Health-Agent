data/mrf/raw/
data/mrf/work/
data/mrf/la_npis.csv
data/mrf/rates.sqlite

# --- Provider directory (built offline, 79 MB) ---
data/providers/

# --- SQLite side files, anywhere ---
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# --- Runtime data from the agent service ---
# Downloaded plan PDFs (official sources listed in docs)
data/policy_pdfs/
# PDFs users upload to the agent service
data/uploads/
# The app database: accounts, conversations, uploads (workflow/appdb.py)
data/app.sqlite*
# Before 2026-11-01 the same data was in these two files; users.sqlite is imported into app.sqlite once
data/sessions.sqlite*
data/users.sqlite*

# --- Fine-tuning runs (predictions and upload scripts, local only) ---
fireworks-training-runs/

# --- Local design assets and decks (not published) ---
decks/
docs/AMD-brand-guidelines.pdf
